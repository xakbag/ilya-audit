# ask/ — только api.php; данные вне веб-корня (~/ask-data).
# Basic-вход корня сюда не наследуется (03.10: api.php 200 с неверным паролем),
# поэтому step99h при выкладке дописывает сверху Auth*-строки из корневого .htaccess.
# Здесь Require не писать — он придёт только вместе с AuthUserFile.
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Cache-Control "no-store"
</IfModule>
