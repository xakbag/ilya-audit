{
  "_note": "Эталонный набор на РЕАЛЬНЫХ ставках (core-rates/rates.json, экспорт step86 02.10.2026, проект «Монплезир Переделкино 2 очередь»). Синтетический прежний набор — eval-set-sample.json (для sample-rates.json). expect.status: ok | conflict | refuse. values — ожидаемые числа; must_not — числа, которых не должно быть в ответе. Терраса дом 10: руб/м² 3500/4000 и руб/м 1700/2000 — два разных конфликта версий (оба акта 26.08.2026), единицы не смешиваются.",
  "cases": [
    {"id": "d10-terrace-m2", "q": "Сколько стоит террасная доска за м² на дом 10?",
     "expect": {"status": "conflict", "values": [3500, 4000], "unit": "м²", "must_not": [1700, 2000],
                "text_has": ["26.08", "комплексная строка", "Конфликт версий"]}},
    {"id": "d10-terrace-m2-alias", "q": "Дом №10, террасная доска, цена за кв.м",
     "expect": {"status": "conflict", "values": [3500, 4000], "unit": "м²", "must_not": [1700, 2000]}},
    {"id": "d10-terrace-m", "q": "Дом 10 террасная доска за погонный метр?",
     "expect": {"status": "conflict", "values": [1700, 2000], "unit": "м", "must_not": [3500, 4000],
                "text_has": ["26.08", "Конфликт версий"]}},
    {"id": "d10-terrace-m-price", "q": "Сколько стоит террасная доска за погонный метр, дом 10?",
     "expect": {"status": "conflict", "values": [1700, 2000], "unit": "м", "must_not": [3500, 4000]}},
    {"id": "d10-terrace-nounit", "q": "Какая ставка на террасная доска по дому 10?",
     "expect": {"status": "refuse", "reason": "ambiguous_unit", "must_not": [1700, 2000, 3500, 4000]}},
    {"id": "d10-paving-m2", "q": "Дом 10 брусчатка за м²",
     "expect": {"status": "conflict", "values": [1250, 1500], "unit": "м²", "must_not": [2200, 750],
                "text_has": ["17.09"]}},
    {"id": "d10-paving-m", "q": "Дом 10 брусчатка за погонный метр",
     "expect": {"status": "ok", "values": [2200], "unit": "м", "must_not": [1250, 1500, 750]}},
    {"id": "d10-paving-nounit", "q": "Сколько стоит брусчатка на доме 10?",
     "expect": {"status": "refuse", "reason": "ambiguous_unit", "must_not": [1250, 1500, 2200, 750]}},
    {"id": "d10-roof-m2", "q": "Дом 10 устройство кровли за м²",
     "expect": {"status": "ok", "values": [3500], "unit": "м²", "text_has": ["26.08", "Ранее"]}},
    {"id": "d10-roof-m", "q": "Дом 10 устройство кровли за погонный метр",
     "expect": {"status": "refuse", "reason": "unit_mismatch", "must_not": [3500]}},
    {"id": "d12-bases-latest", "q": "Дом 12 устройство оснований, цена за штуку",
     "expect": {"status": "ok", "values": [800], "unit": "шт", "text_has": ["28.08", "Ранее"]}},
    {"id": "d10-slab-m3", "q": "Дом 10 устройство фундаментной плиты, сколько за куб?",
     "expect": {"status": "ok", "values": [8000], "unit": "м³", "text_has": ["01.07", "Ранее"]}},
    {"id": "d10-facade", "q": "Дом 10 покраска фасада за м²",
     "expect": {"status": "refuse", "reason": "unknown_work", "must_not": [450]}},
    {"id": "d7-terrace", "q": "Дом 7 террасная доска за м²",
     "expect": {"status": "refuse", "reason": "unknown_work", "must_not": [3500, 4000]}},
    {"id": "d99", "q": "Дом 99 устройство кровли за м²",
     "expect": {"status": "refuse", "reason": "unknown_object", "must_not": [3500]}},
    {"id": "no-object", "q": "Сколько стоит террасная доска за м²?",
     "expect": {"status": "refuse", "reason": "no_object", "must_not": [3500, 4000]}},
    {"id": "unknown-work", "q": "Дом 10 укладка плитки за м²",
     "expect": {"status": "refuse", "reason": "unknown_work"}}
  ]
}
